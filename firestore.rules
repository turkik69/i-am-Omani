rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function mine(uid) { return signedIn() && request.auth.uid == uid; }
    match /usernames/{username} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && username.matches('^[a-z0-9_]{3,24}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;
      allow update, delete: if false;
    }
    match /users/{uid} {
      allow read: if mine(uid);
      allow create: if mine(uid)
        && request.resource.data.keys().hasOnly(['username','email','phone','xp','level','badges','createdAt'])
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z0-9_]{3,24}$')
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.phone is string
        && request.resource.data.xp == 0
        && request.resource.data.level == 1
        && request.resource.data.badges == []
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;
      allow update: if mine(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['progress','xp','level','badges'])
        && request.resource.data.xp is int
        && request.resource.data.xp >= 0
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.level <= 8
        && request.resource.data.badges is list
        && request.resource.data.progress is map;
      allow delete: if false;
    }
  }
}
